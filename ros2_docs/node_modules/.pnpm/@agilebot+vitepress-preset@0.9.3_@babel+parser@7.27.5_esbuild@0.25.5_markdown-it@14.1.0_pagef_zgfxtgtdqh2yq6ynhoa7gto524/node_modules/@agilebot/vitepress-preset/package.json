{
  "name": "@agilebot/vitepress-preset",
  "version": "0.9.3",
  "type": "module",
  "description": "VitePress preset used by Agilebot.",
  "main": "./dist/config.mjs",
  "types": "./dist/config.d.mts",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.mts",
      "import": "./dist/pdf.mjs"
    }
  },
  "license": "MIT",
  "keywords": [
    "vitepress"
  ],
  "repository": {
    "url": "sh-agilebot/frontend-toolkit",
    "directory": "packages/vitepress-preset"
  },
  "homepage": "https://github.com/sh-agilebot/frontend-toolkit/tree/master/packages/vitepress-preset#readme",
  "dependencies": {
    "@nolebase/markdown-it-bi-directional-links": "~2.17.2",
